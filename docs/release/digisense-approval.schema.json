{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rentemester.dk/schemas/digisense-approval-v1.json",
  "title": "Rentemester Digisense release approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "decision",
    "approvedAt",
    "reviewer",
    "releaseManifestDigest",
    "imageDigest",
    "version",
    "gitCommit"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "approvalId": { "type": "string", "minLength": 1 },
    "decision": { "const": "approved" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "name"],
      "properties": {
        "organization": { "const": "Digisense" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "releaseManifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
